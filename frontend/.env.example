# Copy this file to .env and adjust if your backend runs elsewhere.
VITE_API_URL=http://localhost:8000

# Required for file upload to work. This is Supabase's anon/PUBLIC key -
# safe to expose in frontend code, unlike the service_role key the
# backend uses. Find it in your Supabase project: Project Settings > API
# > "anon public" key. Without this, every upload will fail at Supabase's
# gateway with no useful error message in the UI.
VITE_SUPABASE_ANON_KEY=your-anon-public-key
